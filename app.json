{
  "expo": {
    "name": "cappellan",
    "slug": "capellanes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "capellanes-app",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capellania.evangelica.pdlc",
      "infoPlist": {
        "NSCameraUsageDescription": "CapellanAPP necesita acceso a la cámara para las sesiones de videollamada de acompañamiento espiritual.",
        "NSMicrophoneUsageDescription": "CapellanAPP necesita acceso al micrófono para las llamadas de acompañamiento pastoral.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "voip",
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png" 
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.capellania.evangelica.pdlc",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL"
      ],
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B192C",
          "sounds": [
            "./assets/sounds/incoming_call.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PerlitaWidget",
              "label": "Perlita del Día",
              "description": "Versículo bíblico y reflexión táctica diaria de guardia",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "owner": "alessandrobarrionuevos-team",
    "extra": {
      "eas": {
        "projectId": "80e6cc1f-2583-4231-9976-18aa4c67f7b6"
      }
    }
  }
}
