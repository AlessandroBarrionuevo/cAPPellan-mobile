# Backend API base URL
# Android Emulator uses http://10.0.2.2:8080
# iOS Simulator / Web uses http://localhost:8080
# Physical Device uses your local machine IP, e.g. http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=https://statistical-planets-heads-current.trycloudflare.com

# LiveKit WebRTC WebSocket Server URL
# Android Emulator uses ws://10.0.2.2:7880
# iOS Simulator / Web uses ws://localhost:7880
# Production uses wss://your-livekit-server:7880
EXPO_PUBLIC_LIVEKIT_WS_URL=ws://localhost:7880


# PAra poder inicializar el server local $env:EXPO_PACKAGER_PROXY_URL="url"